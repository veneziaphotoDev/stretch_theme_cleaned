{%- comment -%}
  ----------------------------------------------------------------------------------------------------------------------
  SESSIONS GRID SECTION
  ----------------------------------------------------------------------------------------------------------------------

  Displays a hand-picked list of bookable session products (see snippets/session-card.liquid) in a responsive grid.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --product-list-column-count: {{ section.settings.products_per_row_mobile | times: 1 }};
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} {
      --product-list-column-count: 2;
    }
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      --product-list-column-count: {{ section.settings.products_per_row_desktop }};
    }
  }
</style>

<div {% if section.settings.anchor != blank %}id="{{ section.settings.anchor }}"{% endif %} class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  <div class="container section-spacing">
    <div class="sessions-grid__header">
      {%- if section.settings.heading != blank -%}
        <div class="sessions-grid__heading">
          {%- render 'heading', content: section.settings.heading, style: 'h2', indent: 'none', highlight_effect: 'default', balance_text: true -%}
        </div>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="sessions-grid__subheading text-subdued">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- capture sizes -%}(max-width: 699px) calc(100vw / {{ section.settings.products_per_row_mobile }} - 40px), (max-width: 999px) calc(100vw / 2 - 64px), calc((100vw - 96px) / {{ section.settings.products_per_row_desktop }}){%- endcapture -%}

    <div class="product-list">
      {%- liquid
        for product in section.settings.product_list
          render 'session-card', product: product, sizes: sizes, position: forloop.index
        endfor
      -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Sessions grid",
  "class": "shopify-section--sessions-grid",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Section anchor",
      "info": "For menu links (e.g., #sessions)"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Upcoming Sessions"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Sunrise & Sunset · small-group departures"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Sessions"
    },
    {
      "type": "select",
      "id": "products_per_row_mobile",
      "label": "Products per row (mobile)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "products_per_row_desktop",
      "label": "Products per row (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Sessions grid"
    }
  ]
}
{% endschema %}
