{%- liquid
  assign open_dropdown_menu_in_sidebar = false

  if section.settings.show_country_selector and localization.available_countries.size > 1
    assign show_country_selector = true
  endif

  if section.settings.show_locale_selector and localization.available_languages.size > 1
    assign show_locale_selector = true
  endif

  if section.settings.desktop_dropdown_menu_style == 'sidebar' and section.settings.desktop_layout == 'logo_center_navigation_inline'
    assign open_dropdown_menu_in_sidebar = true
  endif

  # The "expand" reveal slides a full width band down from the header behind an open dropdown. It only
  # makes sense for dropdowns that open below the header, so the sidebar mode opts out even if the
  # setting is left on: there the menu opens laterally and there is nothing under the header to fill.
  assign expand_dropdown_reveal = false

  if section.settings.desktop_dropdown_reveal == 'expand' and open_dropdown_menu_in_sidebar == false
    assign expand_dropdown_reveal = true
  endif

  # The localization selectors follow the menu's own open trigger rather than carrying a setting of their
  # own: they sit in the same bar and a menu that opens on hover next to one that needs a click reads as
  # two different components. Click stays available either way -- data-open-on-hover only adds hover.
  assign open_selectors_on_hover = false

  if section.settings.menu_open_trigger == 'hover'
    assign open_selectors_on_hover = true
  endif
-%}

<style>
  :root {
    --header-is-sticky: {% if section.settings.enable_sticky %}1{% else %}0{% endif %};
    --header-is-visible: 1;
  }

  #shopify-section-{{ section.id }} {
    {%- case section.settings.mobile_layout -%}
      {%- when 'logo_left_navigation_right' -%}
        --header-grid: "logo secondary-nav" / auto minmax(0, 1fr);
      
      {%- when 'logo_with_menu_left_navigation_right' -%}
        --header-grid: "primary-nav logo secondary-nav" / auto auto minmax(0, 1fr);

      {%- when 'logo_center_navigation_split' -%}
        --header-grid: "primary-nav logo secondary-nav" / minmax(0, 1fr) auto minmax(0, 1fr);
    {%- endcase -%}

    --header-transparent-header-text-color: {{ section.settings.transparent_header_text_color.rgb }};
    --header-non-transparent-text-color: {{ section.settings.color_scheme.settings.text_color.rgb }};
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      {%- case section.settings.desktop_layout -%}
        {%- when 'logo_left_navigation_inline' -%}
          --header-grid: "logo primary-nav secondary-nav" / auto minmax(0, 1fr) auto;

        {%- when 'logo_left_navigation_center' -%}
          --header-grid: "logo primary-nav secondary-nav" / minmax(max-content, 1fr) auto minmax(max-content, 1fr);

        {%- else -%}
          --header-grid: "primary-nav logo secondary-nav" / minmax(0, 1fr) auto minmax(0, 1fr);
      {%- endcase -%}
    }
  }

  {%- if section.settings.enable_sticky -%}
    #shopify-section-{{ section.id }} {
      position: sticky;
      top: 0;
    }

    .shopify-section--announcement-bar ~ #shopify-section-{{ section.id }} {
      top: calc(var(--announcement-bar-is-sticky, 0) * var(--announcement-bar-height, 0px));
    }
  {%- endif -%}

  {%- if section.settings.logo != blank -%}
    #shopify-section-{{ section.id }} {
      --header-logo-width: {{ section.settings.logo_mobile_max_width }}px;
    }

    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} {
        --header-logo-width: {{ section.settings.logo_max_width }}px;
      }
    }
  {%- endif -%}
</style>

<height-observer variable="header">
  <x-header class="header color-scheme color-scheme--{{ section.settings.color_scheme.id }} {% if expand_dropdown_reveal %}header--expand-dropdown{% endif %}" {% if section.settings.hide_on_scroll %}hide-on-scroll{% endif %}>
    {%- comment -%}
    --------------------------------------------------------------------------------------------------------------------
    LOGO AREA
    --------------------------------------------------------------------------------------------------------------------
    {%- endcomment -%}

    {%- capture logo_content -%}
      {%- if section.settings.logo != blank -%}
        {%- capture sizes -%}{{ section.settings.logo_max_width }}px{%- endcapture -%}
        {%- capture widths -%}{{ section.settings.logo_max_width | times: 2 | at_most: section.settings.logo.width }}, {{ section.settings.logo_max_width | times: 3 | at_most: section.settings.logo.width }}{%- endcapture -%}

        <span class="sr-only">{{ shop.name }}</span>

        {%- assign alt_text = section.settings.logo.alt | default: shop.name -%}
        {{- section.settings.logo | image_url: width: section.settings.logo.width | image_tag: sizes: sizes, widths: widths, alt: alt_text, class: 'header__logo-image' -}}

        {%- if section.settings.transparent_logo -%}
          {{- section.settings.transparent_logo | image_url: width: section.settings.transparent_logo.width | image_tag: sizes: sizes, widths: widths, class: 'header__logo-image header__logo-image--transparent' -}}
        {%- endif -%}
      {%- else -%}
        <p class="header__logo-text heading">{{ shop.name }}</p>
      {%- endif -%}
    {%- endcapture -%}

    {%- if request.page_type == 'index' -%}
      <h1 class="header__logo">
        <a href="{{ routes.root_url }}">{{ logo_content }}</a>
      </h1>
    {% else %}
      <a href="{{ routes.root_url }}" class="header__logo">{{ logo_content }}</a>
    {% endif %}

    {%- comment -%}
    --------------------------------------------------------------------------------------------------------------------
    PRIMARY NAVIGATION AREA
    --------------------------------------------------------------------------------------------------------------------
    {%- endcomment -%}

    {%- assign menu = section.settings.menu -%}
    {%- assign sidebar_menu = section.settings.sidebar_menu -%}

    {%- if menu.links.size > 0 or sidebar_menu.links.size > 0 -%}
      {%- liquid
        assign primary_nav_extra_classes = ''

        if open_dropdown_menu_in_sidebar
          assign primary_nav_extra_classes = primary_nav_extra_classes | append: ' header__primary-nav--open-menu-in-sidebar'
        endif

        case section.settings.mobile_layout
          when 'logo_left_navigation_right'
            assign primary_nav_extra_classes = primary_nav_extra_classes | append: ' hidden md:flex'
        endcase

        case section.settings.desktop_layout
          when 'logo_left_navigation_center'
            assign primary_nav_extra_classes = primary_nav_extra_classes | append: ' md:justify-center'
        endcase
      -%}

      <nav class="header__primary-nav {{ primary_nav_extra_classes }}" aria-label="{{ 'header.general.primary_navigation' | t | escape }}">
        <button type="button" aria-controls="menu-drawer" class="tap-area {% unless section.settings.desktop_layout == 'drawer' %}md:hidden{% endunless %}">
          <span class="sr-only">{{ 'header.general.menu' | t }}</span>

          <div class="h-stack gap-3" aria-hidden="true">
            <div class="header__hamburger">
              <span></span>
              <span></span>
            </div>

            <span class="subheading md-max:hidden">{{ 'header.general.menu' | t }}</span>
          </div>
        </button>

        {%- if section.settings.show_search and section.settings.mobile_layout == 'logo_center_navigation_split' -%}
          <a href="{{ routes.search_url }}" class="header__search-link tap-area md:hidden" aria-controls="search-drawer">
            <span class="sr-only">{{ 'header.general.search' | t }}</span>
            {%- render 'icon' with 'search', mobile_width: 16, width: section.settings.desktop_icon_size -%}
          </a>
        {%- endif -%}

        {%- if menu.links.size > 0 and section.settings.desktop_layout != 'drawer' -%}
          <ul class="contents unstyled-list md-max:hidden">
            {%- if open_dropdown_menu_in_sidebar -%}
              <li class="contents">
                <button type="button" aria-controls="menu-dropdown-sidebar" class="tap-area">
                  <span class="sr-only">{{ 'header.general.menu' | t }}</span>

                  <div class="header__hamburger">
                    <span></span>
                    <span></span>
                  </div>
                </button>
              </li>
            {%- endif -%}

            {%- for link in menu.links -%}
              {% liquid
                assign link_title_downcase = link.title | strip | downcase
                assign mega_menu_block = ''

                for block in section.blocks
                  assign menu_item_downcase = block.settings.menu_item | strip | downcase

                  if menu_item_downcase == link_title_downcase
                    assign mega_menu_block = block
                    break
                  endif

                endfor
              %}

              <li>
                {%- liquid
                  assign has_dropdown_menu = false
                  assign menu_id = 'header-menu-dropdown-' | append: forloop.index
                  
                  if link.levels > 0 or mega_menu_block != ''
                    assign has_dropdown_menu = true
                  endif
                -%}

                {%- comment -%}
                  h-stack rather than block when the item carries a marker, so the label and the marker sit
                  on one row with the theme's own gap. Without a marker the class is left exactly as it was.
                {%- endcomment -%}
                <a href="{{ link.url }}" class="{% if has_dropdown_menu %}h-stack gap-2{% else %}block{% endif %} subheading link-reversed" {% if link.current %}aria-current="page"{% endif %} {% if open_dropdown_menu_in_sidebar and has_dropdown_menu %}aria-expanded="false" aria-controls="menu-dropdown-sidebar" data-link-position="{{ forloop.index }}"{% elsif has_dropdown_menu %}aria-expanded="false" aria-controls="{{ menu_id }}" {% if section.settings.menu_open_trigger == 'hover' %}data-open-on-hover{% endif %}{% endif %}>
                  {{- link.title -}}

                  {%- if has_dropdown_menu -%}
                    {%- render 'plus-minus-toggle' -%}
                  {%- endif -%}
                </a>

                {%- if has_dropdown_menu and open_dropdown_menu_in_sidebar == false -%}
                  {%- if mega_menu_block == '' -%}
                    <header-dropdown-menu class="header__dropdown-menu color-scheme color-scheme--{{ section.settings.color_scheme.id }}" id="{{ menu_id }}">
                      <ul class="unstyled-list">
                        {%- for sub_link in link.links -%}
                          {%- assign sub_menu_id = menu_id | append: '-' | append: forloop.index -%}

                          <li>
                            <a href="{{ sub_link.url }}" class="subheading link-faded-reverse" {% if sub_link.current %}aria-current="page"{% endif %} {% if sub_link.levels > 0 %}aria-expanded="false" aria-controls="{{ sub_menu_id }}" {% if section.settings.menu_open_trigger == 'hover' %}data-open-on-hover{% endif %}{% endif %}>
                              {{- sub_link.title -}}

                              {%- if sub_link.levels > 0 -%}
                                {%- render 'icon' with 'chevron-right', direction_aware: true -%}
                              {%- endif -%}
                            </a>

                            {%- if sub_link.levels > 0 -%}
                              <header-dropdown-menu class="header__dropdown-menu color-scheme color-scheme--{{ section.settings.color_scheme.id }}" id="{{ sub_menu_id }}">
                                <ul class="unstyled-list">
                                  {%- for sub_sub_link in sub_link.links -%}
                                    <li>
                                      <a href="{{ sub_sub_link.url }}" class="subheading link-faded-reverse" {% if sub_sub_link.current %}aria-current="page"{% endif %}>{{ sub_sub_link.title }}</a>
                                    </li>
                                  {%- endfor -%}
                                </ul>
                              </header-dropdown-menu>
                            {%- endif -%}
                          </li>
                        {%- endfor -%}
                      </ul>
                    </header-dropdown-menu>
                  {%- else -%}
                    {%- render 'mega-menu', link: link, color_scheme: section.settings.color_scheme, id: menu_id, block: mega_menu_block -%}
                  {%- endif -%}
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </nav>
    {%- endif -%}

    {%- comment -%}
    --------------------------------------------------------------------------------------------------------------------
    SECONDARY NAVIGATION AREA
    --------------------------------------------------------------------------------------------------------------------
    {%- endcomment -%}

    <nav class="header__secondary-nav" aria-label="{{ 'header.general.secondary_navigation' | t | escape }}">
      <ul class="contents unstyled-list">
        {%- comment -%}
          The secondary menu setting already feeds the mobile drawer and the dropdown sidebar
          (main-menu-drawer.liquid:71, main-menu-dropdown-sidebar.liquid:132), but had nowhere to go on
          desktop. Its links open this nav, ahead of the localization selectors and the icon run that
          closes it, so a link moved out of the main menu still reads as a link rather than a control.

          Hidden below md because the drawer already carries the same links there, the way the account
          link is hidden below md for the drawer that carries it.
        {%- endcomment -%}
        {%- if section.settings.secondary_menu.links.size > 0 -%}
          {%- for link in section.settings.secondary_menu.links -%}
            <li class="md-max:hidden">
              <a href="{{ link.url }}" class="block subheading link-reversed" {% if link.current %}aria-current="page"{% endif %}>
                {{- link.title -}}
              </a>
            </li>
          {%- endfor -%}
        {%- endif -%}

        {%- if show_country_selector or show_locale_selector -%}
          <li class="hidden md:contents">
            <div class="h-stack justify-between">
              {%- if show_country_selector or show_locale_selector -%}
                <div class="h-stack gap-5">
                  {%- liquid
                    if show_country_selector
                      render 'localization-selector', type: 'country', show_country_name: section.settings.show_country_name, show_country_flag: section.settings.show_country_flag, preferred_alignment: 'start', id_prefix: 'secondary-nav', open_on_hover: open_selectors_on_hover
                    endif

                    if show_locale_selector
                      render 'localization-selector', type: 'locale', preferred_alignment: 'start', id_prefix: 'secondary-nav', open_on_hover: open_selectors_on_hover
                    endif
                  -%}
                </div>
              {%- endif -%}
            </div>

            <hr class="header__secondary-nav-separator" />
          </li>
        {%- endif -%}

        {%- comment -%}Offer a hook for apps to integrate into the header to add their own icon, for instance{%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}
            <li>
              {%- render block -%}
            </li>
          {%- endif -%}
        {%- endfor -%}

        {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
          <li class="header__account-link md-max:hidden">
            <shopify-account menu="{{ section.settings.customer_account_menu }}">
              <div slot="signed-out-avatar" class="tap-area">
                <span class="sr-only">{{ 'header.general.login' | t }}</span>
                {%- render 'icon' with 'account', mobile_width: 16, width: section.settings.desktop_icon_size -%}
              </div>
            </shopify-account>
          </li>
        {%- endif -%}

        <li class="header__news-link" hidden>
          <news-modal-button class="contents">
            <button class="tap-area" aria-controls="news-modal" aria-expanded="false">
              <span class="sr-only">{{ 'header.general.news_modal' | t }}</span>
              {%- render 'icon' with 'bell', mobile_width: 16, width: section.settings.desktop_icon_size -%}
            </button>
          </news-modal-button>
        </li>

        {%- if section.settings.show_search -%}
          <li class="header__search-link {% if section.settings.mobile_layout == 'logo_center_navigation_split' %}md-max:hidden{% endif %}">
            <a href="{{ routes.search_url }}" class="block tap-area" aria-controls="search-drawer">
              <span class="sr-only">{{ 'header.general.search' | t }}</span>
              {%- render 'icon' with 'search', mobile_width: 16, width: section.settings.desktop_icon_size -%}
            </a>
          </li>
        {%- endif -%}

        <li class="header__cart-link relative">
          <a href="{{ routes.cart_url }}" class="block tap-area" {% if settings.cart_type != 'page' and request.page_type != 'cart' %}aria-controls="cart-drawer"{% endif %} data-no-instant>
            <span class="sr-only">{{ 'header.general.cart' | t }}</span>
            {%- render 'icon' with 'cart', mobile_width: 16, width: section.settings.desktop_icon_size -%}
          </a>

          <cart-count class="header__active-dot" {%- if cart.empty? -%}hidden{% endif %}>
            <span class="sr-only">{{ 'cart.general.item_count' | t: count: cart.item_count }}</span>
          </cart-count>
        </li>

        {%- if section.settings.mobile_layout == 'logo_left_navigation_right' -%}
          <li class="header__menu-link md:hidden">
            <button class="block tap-area" type="button" aria-controls="menu-drawer">
              <span class="sr-only">{{ 'header.general.menu' | t }}</span>

              <div class="h-stack gap-3" aria-hidden="true">
                <div class="header__hamburger">
                  <span></span>
                  <span></span>
                </div>
              </div>
            </button>
          </li>
        {%- endif -%}
      </ul>
    </nav>

    {%- comment -%}
    ------------------------------------------------------------------------------------------------------------------
    DRAWER MENU
    -----------------------------------------------------------------------------------------------------------------
    {%- endcomment -%}

    {%- assign primary_menu = section.settings.drawer_menu | default: section.settings.menu -%}

    {%- render 'main-menu-drawer', 
      primary_menu: primary_menu, 
      secondary_menu: section.settings.secondary_menu,
      show_nested_menu_indicator: section.settings.drawer_show_nested_menu_indicator,
      show_country_selector: show_country_selector,
      show_country_name: section.settings.show_country_name,
      show_country_flag: section.settings.show_country_flag,
      show_locale_selector: show_locale_selector,
      color_scheme: section.settings.color_scheme
    -%}

    {%- comment -%}
    ------------------------------------------------------------------------------------------------------------------
    SIDEBAR MENU FOR DROPDOWN ITEM

    This is a special mode that can be enabled by setting the desktop layout to "logo center, navigation inline" and 
    the dropdown menu style to "sidebar". When configured like this, the dropdown menu will open in a lateral sidebar
    -----------------------------------------------------------------------------------------------------------------
    {%- endcomment -%}

    {%- if open_dropdown_menu_in_sidebar -%}
      {%- render 'main-menu-dropdown-sidebar', 
        primary_menu: section.settings.menu, 
        secondary_menu: section.settings.secondary_menu,
        color_scheme: section.settings.color_scheme
      -%}
    {%- endif -%}
  </x-header>
</height-observer>

<script>
  document.documentElement.style.setProperty('--header-height', `${Math.round(document.getElementById('shopify-section-{{ section.id }}').clientHeight)}px`);
</script>

{%- if expand_dropdown_reveal -%}
  {%- comment -%}
  The reveal is a three beat sequence, and CSS can only express the middle one. This script supplies the
  two it cannot reach:

    beat 1  the header bar fades to solid, and is held there until the band has gone
    beat 2  the band slides down, sized to the open panel  (the stylesheet does this)
    beat 3  the panel's own contents animate in

  Closing runs the same three in reverse: contents out, band up, bar back to transparent.

  All of it is emitted only when the setting is on, so a theme left on the default reveal ships none of
  this and keeps Stretch's own instant dropdown.
  {%- endcomment -%}
  <script>
    (() => {
      const header = document.querySelector('#shopify-section-{{ section.id }} .header--expand-dropdown');
      if (!header) return;

      {%- comment -%}
        Every kind of panel the header can open downwards, not just the navigation submenus: a store may
        have a flat menu and still open the country and language selectors, which are popovers and would
        otherwise keep the floating box the setting is meant to replace. Mega menus are included so the
        band is there for them too, even though they already span the full width.

        Panels inside the mobile drawer are excluded. The drawer is its own surface with its own slide in
        animation, and the band belongs to the header bar.
      {%- endcomment -%}
      const panels = [...header.querySelectorAll('header-dropdown-menu, header-mega-menu, x-popover')]
        .filter((panel) => !panel.closest('header-menu-drawer'));

      if (panels.length === 0) return;

      {%- comment -%}
        A popover draws nothing itself: its visible box is a part inside its shadow root, so measuring or
        hiding the host would act on a zero height box. Everything else is its own visible box.
      {%- endcomment -%}
      const visibleBox = (panel) => panel.shadowRoot?.querySelector('[part~="content"]') ?? panel;

      {%- comment -%}
        Read back off the element rather than restated here, so the stylesheet stays the one place the
        timing is set and the two halves of the sequence cannot drift apart.
      {%- endcomment -%}
      const beatMs = () => {
        const beat = getComputedStyle(header).getPropertyValue('--header-dropdown-reveal-beat').trim();
        const value = parseFloat(beat);

        if (!Number.isFinite(value)) return 0;

        return beat.endsWith('ms') ? value : value * 1000;
      };

      {%- comment -%}
        Desktop only, matching the stylesheet. Below that breakpoint the navigation is the drawer and a
        popover is a bottom sheet, so there is no header to expand and nothing to sequence.
      {%- endcomment -%}
      const isDesktop = window.matchMedia('screen and (min-width: 1000px)');

      {%- comment -%}
        BEAT 1, and the reason it needs script at all.

        theme.css drops the transparent treatment through .header:not(.is-solid, :has([open])), which is
        exactly right on the way in: the bar goes solid the moment a panel opens. On the way out it is a
        beat too early. The open attribute is removed before the closing animation even starts, so the
        bar would fade back to transparent underneath a band that is still at full height.

        Holding is-solid ourselves keeps it opaque until the band has finished sliding up. The class is
        released only if we were the ones who added it, and only if the page is still scrolled to the top:
        past the tracker the header is legitimately solid and theme.js owns the class, which only toggles
        on intersection changes and so would not restore it until the next scroll.
      {%- endcomment -%}
      const scrollTracker = document.getElementById('header-scroll-tracker');
      let forcedSolid = false;
      let releaseTimer = null;

      const holdSolid = () => {
        clearTimeout(releaseTimer);

        if (!forcedSolid && !header.classList.contains('is-solid')) {
          header.classList.add('is-solid');
          forcedSolid = true;
        }
      };

      const releaseSolid = () => {
        clearTimeout(releaseTimer);

        releaseTimer = setTimeout(() => {
          if (!forcedSolid || header.hasAttribute('dropdown-expanded')) return;
          if (scrollTracker && scrollTracker.getBoundingClientRect().top < 0) return;

          header.classList.remove('is-solid');
          forcedSolid = false;
        }, beatMs());
      };

      {%- comment -%}
        Measured against the header's own bottom edge rather than taking each panel's height, so a nested
        submenu counts too: it is offset upwards from its parent and can hang lower than the menu that
        opened it. The tallest open panel wins.
      {%- endcomment -%}
      const updateHeight = () => {
        let height = 0;

        if (isDesktop.matches) {
          const headerBottom = header.getBoundingClientRect().bottom;

          panels.forEach((panel) => {
            if (!panel.hasAttribute('open')) return;
            height = Math.max(height, visibleBox(panel).getBoundingClientRect().bottom - headerBottom);
          });
        }

        height = Math.max(0, Math.round(height));

        header.style.setProperty('--dropdown-height', `${height}px`);

        {%- comment -%}
          The stylesheet keys the band on this attribute rather than on a :has() over every panel type, so
          the one place that decides whether anything is open is this function.
        {%- endcomment -%}
        header.toggleAttribute('dropdown-expanded', height > 0);

        height > 0 ? holdSolid() : releaseSolid();
      };

      {%- comment -%}
        BEAT 3. Stretch animates a panel's contents with Motion One, which writes inline styles, so no
        stylesheet can hold them back for two beats. The entry animation has to be wrapped.

        Wrapped per instance rather than on the prototype, which is what v2 patched. The prototype is
        shared by every dropdown on the page and by any other section that opens one, so a change there
        reaches well beyond this header and cannot be undone; an own property is scoped to the panels this
        script collected.

        If a future version of the theme renames the method, the typeof check leaves it alone and the
        reveal degrades to the band alone rather than throwing.

        Deferred until the element has been upgraded. This script is inline and runs while the document
        is parsing, but theme.js is a module and so is deferred until after it: until that has run these
        are unknown elements with no methods on them at all, and wrapping one now would find nothing and
        silently skip every panel on the page.
      {%- endcomment -%}
      const sequenceContents = (panel) => {
        const original = panel.createEnterAnimationControls;
        if (typeof original !== 'function') return;

        panel.createEnterAnimationControls = function () {
          const box = visibleBox(this);
          const delay = beatMs() * 2;

          if (!isDesktop.matches || delay === 0) return original.call(this);

          {%- comment -%}
            Pinned on the panel rather than on its children: at zero opacity nothing inside it can show,
            so the individual items need no handling and the same line covers a popover, whose contents
            are in a shadow root this script should not be reaching into.
          {%- endcomment -%}
          box.style.opacity = '0';

          const unpin = () => box.style.removeProperty('opacity');

          let inner = null;
          let settle;
          const finished = new Promise((resolve) => { settle = resolve; });

          const timer = setTimeout(() => {
            {%- comment -%}
              Closed again during the hold: drop the pin and resolve without ever starting the animation,
              otherwise the panel would animate in on its way out.
            {%- endcomment -%}
            if (!this.hasAttribute('open')) {
              unpin();
              settle();
              return;
            }

            unpin();
            inner = original.call(this);
            inner?.then ? inner.then(settle) : settle();
          }, delay);

          {%- comment -%}
            DialogElement stores what this returns and later calls .cancel() on it when the panel closes
            mid animation, and .complete() when asked to open without animating. A bare promise, which is
            what v2's patch returned, has neither and throws on any dropdown closed inside the hold.
          {%- endcomment -%}
          const stop = (method) => {
            clearTimeout(timer);
            unpin();
            inner?.[method]?.();
            settle();
          };

          return {
            then: (...args) => finished.then(...args),
            cancel: () => stop('cancel'),
            complete: () => stop('complete'),
          };
        };
      };

      panels.forEach((panel) => {
        customElements.whenDefined(panel.localName).then(() => {
          customElements.upgrade(panel);
          sequenceContents(panel);
        });

        {%- comment -%}
          The open attribute is set before dialog:before-show fires and removed before dialog:after-hide,
          so reading it in updateHeight is accurate at both ends without waiting a frame. after-hide lands
          once the panel has finished fading, which is what puts the band's collapse on the second beat of
          the close rather than alongside the first.
        {%- endcomment -%}
        panel.addEventListener('dialog:before-show', updateHeight);
        panel.addEventListener('dialog:after-hide', updateHeight);
      });

      isDesktop.addEventListener('change', updateHeight);
    })();
  </script>
{%- endif -%}

