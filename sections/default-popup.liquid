{%- unless request.page_type == 'captcha' or section.settings.show_only_on_index and template != 'index' -%}
  {%- unless section.settings.show_only_for_visitors and customer -%}

<x-modal class="modal modal--default color-scheme color-scheme--{{ section.settings.color_scheme.id }}" id="default-popup" title="{{ section.settings.title | default: 'Popup' | escape }}" {% if section.settings.show_only_once %}only-once{% endif %} handle-editor-events>
  {%- if section.settings.image != blank -%}
    {{- section.settings.image | image_url: width: section.settings.image.width | image_tag: loading: 'lazy', sizes: '(max-width: 699px) 100vw, 430px', widths: '200,400,600,800,1000,1200', slot: 'image' -}}
  {%- endif -%}

  <div class="v-stack gap-6" style="padding-inline-end: 2rem">
    {%- if section.settings.title != blank -%}
      <p class="h4">{{ section.settings.title }}</p>
    {%- endif -%}

    {%- if section.settings.content != blank -%}
      <div class="prose">{{ section.settings.content }}</div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="h-stack gap-4 wrap">
        {%- for block in section.blocks -%}
          {%- if block.settings.text != blank -%}
            {%- render 'button',
              href: block.settings.url,
              content: block.settings.text,
              style: block.settings.style,
              background: block.settings.background,
              text_color: block.settings.text_color,
              external: block.settings.open_in_new_tab,
              icon: block.settings.icon,
              icon_position: block.settings.icon_position,
              block: block
            -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</x-modal>

{%- if section.settings.trigger_section != blank -%}
  <script>
    (function() {
      customElements.whenDefined('x-modal').then(() => {
        const modal = document.getElementById('default-popup');
        const triggerSection = document.getElementById('{{ section.settings.trigger_section }}');
        const delay = {{ section.settings.apparition_delay | default: 0 }} * 1000;
        const showOnlyOnce = {{ section.settings.show_only_once | json }};
        const storageKey = 'theme:default-popup-shown';

        if (!modal || !triggerSection) return;
        if (showOnlyOnce && localStorage.getItem(storageKey) === 'true') return;

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              observer.disconnect();
              setTimeout(() => {
                modal.show();
                if (showOnlyOnce) {
                  localStorage.setItem(storageKey, 'true');
                }
              }, delay);
            }
          });
        }, { threshold: 0.1 });

        observer.observe(triggerSection);
      });
    })();
  </script>
{%- endif -%}

  {%- endunless -%}
{%- endunless -%}

{% schema %}
{
  "name": "Default popup",
  "class": "shopify-section--popup",
  "enabled_on": {
    "groups": ["custom.overlay"]
  },
  "limit": 1,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Trigger settings"
    },
    {
      "type": "text",
      "id": "trigger_section",
      "label": "Trigger section anchor",
      "info": "Enter the anchor ID of a section (e.g., 'about'). Popup shows when that section scrolls into view."
    },
    {
      "type": "range",
      "id": "apparition_delay",
      "min": 0,
      "max": 15,
      "step": 1,
      "unit": "sec",
      "label": "Delay until popup appears",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "show_only_on_index",
      "label": "Show only on home page",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_only_for_visitors",
      "label": "Hide for account holders",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_only_once",
      "label": "Show once to visitors",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "1000 x 1000px .jpg recommended"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "Popup title"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Add your content here.</p>"
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Button text"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open in new tab",
          "default": false
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            {
              "value": "outline",
              "label": "Outline"
            },
            {
              "value": "solid",
              "label": "Solid"
            },
            {
              "value": "link",
              "label": "Link"
            }
          ],
          "default": "solid"
        },
        {
          "type": "color",
          "id": "background",
          "label": "Background"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "",
              "label": "None"
            },
            {
              "value": "custom-plus-icon",
              "label": "Plus"
            },
            {
              "value": "arrow-right",
              "label": "Arrow Right"
            },
            {
              "value": "arrow-left",
              "label": "Arrow Left"
            }
          ],
          "default": ""
        },
        {
          "type": "select",
          "id": "icon_position",
          "label": "Icon Position",
          "options": [
            {
              "value": "before_text",
              "label": "Before Text"
            },
            {
              "value": "after_text",
              "label": "After Text"
            }
          ],
          "default": "before_text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Default popup"
    }
  ]
}
{% endschema %}
