{%- comment -%}
  ----------------------------------------------------------------------------------------------------------------------
  PRODUCT EXPERIENCE DETAILS SECTION
  ----------------------------------------------------------------------------------------------------------------------

  Renders the tour-specific content (promise, quick facts, route, minute-by-minute program, operations note, FAQ)
  from product metafields, so the same section works for every experience without any per-product template or
  hardcoded copy. Meant to be placed on the product template, between "main" and "related-products".

  Expected metafields (namespace "custom"): subtitle, promise, guide_name, total_duration, time_on_water,
  boat_mobilized_time, max_participants, highlight_moment, route_stops (list of metaobject "route_stop": name,
  optional image -- cropped to a fixed 4:5 ratio so mixed photo formats stay consistent), operations_note,
  program_steps (list of metaobject "itinerary_step": time, step, intention), faq_items (list of
  metaobject "faq_item": question, answer), sibling_experience (single product reference, only set on products that
  share the same route as another product at the other time of day).

  Every block below is skipped independently when its metafield is blank, so a product only needs to fill in
  whichever fields apply to it.
{%- endcomment -%}

{%- liquid
  assign promise = product.metafields.custom.promise.value
  assign guide_name = product.metafields.custom.guide_name.value
  assign total_duration = product.metafields.custom.total_duration.value
  assign time_on_water = product.metafields.custom.time_on_water.value
  assign boat_mobilized_time = product.metafields.custom.boat_mobilized_time.value
  assign max_participants = product.metafields.custom.max_participants.value
  assign highlight_moment = product.metafields.custom.highlight_moment.value
  assign route_stops = product.metafields.custom.route_stops.value
  assign operations_note = product.metafields.custom.operations_note.value
  assign program_steps = product.metafields.custom.program_steps.value
  assign faq_items = product.metafields.custom.faq_items.value
  assign sibling = product.metafields.custom.sibling_experience.value

  assign sibling_prompt_key = 'product.experience.sibling_prompt_to_sunset'
  if product.tags contains 'sunset'
    assign sibling_prompt_key = 'product.experience.sibling_prompt_to_sunrise'
  endif

  assign has_facts = false
  if total_duration != blank or time_on_water != blank or boat_mobilized_time != blank or max_participants != blank or highlight_moment != blank
    assign has_facts = true
  endif

  assign has_content = false
  if promise != blank or has_facts or route_stops.size > 0 or operations_note != blank or program_steps.size > 0 or faq_items.size > 0
    assign has_content = true
  endif
-%}

{%- if has_content -%}
  <div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
    <div class="container section-spacing">
      <div class="experience-details">
        {%- if promise != blank -%}
          <div class="experience-details__promise" data-animate>
            {{- promise -}}
          </div>
        {%- endif -%}

        {%- if has_facts -%}
          <div class="experience-facts" data-animate>
            {%- if total_duration != blank -%}
              <div class="experience-facts__item">
                <p class="experience-facts__value">{{ total_duration }}</p>
                <p class="experience-facts__label subheading">{{ 'product.experience.total_duration' | t }}</p>
              </div>
            {%- endif -%}

            {%- if time_on_water != blank -%}
              <div class="experience-facts__item">
                <p class="experience-facts__value">{{ time_on_water }}</p>
                <p class="experience-facts__label subheading">{{ 'product.experience.time_on_water' | t }}</p>
              </div>
            {%- elsif boat_mobilized_time != blank -%}
              <div class="experience-facts__item">
                <p class="experience-facts__value">{{ boat_mobilized_time }}</p>
                <p class="experience-facts__label subheading">{{ 'product.experience.boat_mobilized_time' | t }}</p>
              </div>
            {%- endif -%}

            {%- if max_participants != blank -%}
              <div class="experience-facts__item">
                <p class="experience-facts__value">{{ max_participants }}{% if guide_name != blank %} + {{ guide_name | split: ' ' | first }}{% endif %}</p>
                <p class="experience-facts__label subheading">{{ 'product.experience.max_participants' | t }}</p>
              </div>
            {%- endif -%}

            {%- if highlight_moment != blank -%}
              <div class="experience-facts__item">
                <p class="experience-facts__value">{{ highlight_moment }}</p>
                <p class="experience-facts__label subheading">{{ 'product.experience.highlight_moment' | t }}</p>
              </div>
            {%- endif -%}
          </div>

          {%- if sibling != blank -%}
            <a href="{{ sibling.url }}" class="experience-sibling" data-animate>
              {%- if sibling.featured_media != blank -%}
                {{- sibling.featured_media | image_url: width: 160 | image_tag: loading: 'lazy', sizes: '80px', widths: '80,160', class: 'experience-sibling__image' -}}
              {%- endif -%}
              <span class="experience-sibling__text">
                <span class="experience-sibling__prompt subheading">{{ sibling_prompt_key | t }}</span>
                <span class="experience-sibling__title">{{ sibling.title }}</span>
              </span>
              {%- render 'icon' with 'arrow-right', direction_aware: true, class: 'experience-sibling__arrow' -%}
            </a>
          {%- endif -%}

          {%- if shop.email != blank -%}
            <p class="experience-privatize text-sm text-subdued">
              {{- 'product.experience.privatize_note' | t }}
              <a href="mailto:{{ shop.email }}?subject={{ 'product.experience.privatize_subject' | t: title: product.title | url_encode }}" class="link">{{ 'product.experience.privatize_link' | t }}</a>
            </p>
          {%- endif -%}
        {%- endif -%}

        {%- if route_stops.size > 0 -%}
          <div class="experience-route" data-animate>
            <p class="experience-route__title subheading">{{ 'product.experience.route_title' | t }}</p>

            <scroll-carousel id="experience-route-{{ section.id }}" allow-swipe cell-selector=".experience-route__stop" class="experience-route__stops scroll-area bleed sm:unbleed snap-x" role="region">
              {%- for stop in route_stops -%}
                {%- assign stop_image = stop.image.value -%}
                <div class="experience-route__stop {% if stop_image != blank %}experience-route__stop--has-image{% endif %}" role="group" aria-label="{{ 'general.accessibility.item_nth_of_count' | t: index: forloop.index, count: route_stops.size }}">
                  {%- if stop_image != blank -%}
                    <div class="experience-route__stop-media">
                      {{- stop_image | image_url: width: 400, height: 500, crop: 'center' | image_tag: loading: 'lazy', sizes: '176px', widths: '176,352', alt: stop.name.value, class: 'experience-route__stop-image' -}}
                      <div class="experience-route__stop-caption">
                        <p class="experience-route__stop-index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</p>
                        <p class="experience-route__stop-name">{{ stop.name.value }}</p>
                      </div>
                    </div>
                  {%- else -%}
                    <p class="experience-route__stop-index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</p>
                    <p class="experience-route__stop-name">{{ stop.name.value }}</p>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </scroll-carousel>

            {%- if route_stops.size > 1 -%}
              <carousel-navigation class="scroll-marker-group scroll-marker-group--lines justify-self-center" aria-controls="experience-route-{{ section.id }}">
                {%- for stop in route_stops -%}
                  <button class="scroll-marker tap-area tap-area--sm" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
                    <span class="sr-only">{{ 'general.accessibility.go_to_item' | t: index: forloop.index }}</span>
                  </button>
                {%- endfor -%}
              </carousel-navigation>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if operations_note != blank or program_steps.size > 0 or faq_items.size > 0 -%}
          <div class="experience-details__accordions" data-animate>
            {%- if program_steps.size > 0 -%}
              {%- capture program_content -%}
                <ol class="experience-program">
                  {%- for step in program_steps -%}
                    <li class="experience-program__step">
                      <span class="experience-program__time subheading">{{ step.time.value }}</span>
                      <span class="experience-program__title">{{ step.step.value }}</span>
                      {%- if step.intention.value != blank -%}
                        <span class="experience-program__intention text-subdued">{{ step.intention.value }}</span>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ol>
              {%- endcapture -%}
              {%- render 'accordion', title: 'product.experience.program_title' | t, content: program_content, open: true -%}
            {%- endif -%}

            {%- if operations_note != blank -%}
              {%- capture operations_content -%}<div class="prose">{{ operations_note }}</div>{%- endcapture -%}
              {%- render 'accordion', title: 'product.experience.operations_note_title' | t, content: operations_content -%}
            {%- endif -%}

            {%- if faq_items.size > 0 -%}
              {%- capture faq_content -%}
                <div class="v-stack gap-4">
                  {%- for item in faq_items -%}
                    {%- capture answer_content -%}<div class="prose">{{ item.answer.value }}</div>{%- endcapture -%}
                    {%- render 'accordion', title: item.question.value, content: answer_content, subheading_title: true -%}
                  {%- endfor -%}
                </div>
              {%- endcapture -%}
              {%- render 'accordion', title: 'product.experience.faq_title' | t, content: faq_content, open: true -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if faq_items.size > 0 -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- for item in faq_items -%}
            {
              "@type": "Question",
              "name": {{ item.question.value | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ item.answer.value | strip_html | json }}
              }
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Experience details",
  "class": "shopify-section--product-experience-details",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Experience details"
    }
  ]
}
{% endschema %}