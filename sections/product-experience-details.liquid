{%- comment -%}
  ----------------------------------------------------------------------------------------------------------------------
  PRODUCT EXPERIENCE DETAILS SECTION
  ----------------------------------------------------------------------------------------------------------------------

  Renders the tour-specific content (promise, quick facts, minute-by-minute program, route, operations note, FAQ) from
  product metafields, so the same section works for every experience without any per-product template or hardcoded
  copy. Meant to be placed on the product template, between "main" and "related-products".

  Expected metafields (namespace "custom"): subtitle, promise, guide_name, duration_total, time_on_water,
  boat_time_mobilized, participants_max, highlight_moment, route, operations_note, program_steps (list of
  metaobject "itinerary_step": time, step, intention), faq (list of metaobject "faq_item": question, answer).

  Every block below is skipped independently when its metafield is blank, so a product only needs to fill in
  whichever fields apply to it.
{%- endcomment -%}

{%- liquid
  assign promise = product.metafields.custom.promise.value
  assign guide_name = product.metafields.custom.guide_name.value
  assign duration_total = product.metafields.custom.duration_total.value
  assign time_on_water = product.metafields.custom.time_on_water.value
  assign boat_time_mobilized = product.metafields.custom.boat_time_mobilized.value
  assign participants_max = product.metafields.custom.participants_max.value
  assign highlight_moment = product.metafields.custom.highlight_moment.value
  assign route = product.metafields.custom.route.value
  assign operations_note = product.metafields.custom.operations_note.value
  assign program_steps = product.metafields.custom.program_steps.value
  assign faq_items = product.metafields.custom.faq.value

  assign has_facts = false
  if duration_total != blank or time_on_water != blank or boat_time_mobilized != blank or participants_max != blank or highlight_moment != blank
    assign has_facts = true
  endif

  assign has_content = false
  if promise != blank or has_facts or route != blank or operations_note != blank or program_steps.size > 0 or faq_items.size > 0
    assign has_content = true
  endif
-%}

{%- if has_content -%}
  <div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
    <div class="container section-spacing">
      <div class="experience-details">
        {%- if promise != blank -%}
          <div class="experience-details__promise" data-animate>
            {{- promise -}}
          </div>
        {%- endif -%}

        {%- if has_facts -%}
          <div class="experience-facts" data-animate>
            {%- if duration_total != blank -%}
              <div class="experience-facts__item">
                <p class="experience-facts__value">{{ duration_total }}</p>
                <p class="experience-facts__label subheading">{{ 'product.experience.duration_total' | t }}</p>
              </div>
            {%- endif -%}

            {%- if time_on_water != blank -%}
              <div class="experience-facts__item">
                <p class="experience-facts__value">{{ time_on_water }}</p>
                <p class="experience-facts__label subheading">{{ 'product.experience.time_on_water' | t }}</p>
              </div>
            {%- elsif boat_time_mobilized != blank -%}
              <div class="experience-facts__item">
                <p class="experience-facts__value">{{ boat_time_mobilized }}</p>
                <p class="experience-facts__label subheading">{{ 'product.experience.boat_time_mobilized' | t }}</p>
              </div>
            {%- endif -%}

            {%- if participants_max != blank -%}
              <div class="experience-facts__item">
                <p class="experience-facts__value">{{ participants_max }}{% if guide_name != blank %} + {{ guide_name | split: ' ' | first }}{% endif %}</p>
                <p class="experience-facts__label subheading">{{ 'product.experience.participants_max' | t }}</p>
              </div>
            {%- endif -%}

            {%- if highlight_moment != blank -%}
              <div class="experience-facts__item">
                <p class="experience-facts__value">{{ highlight_moment }}</p>
                <p class="experience-facts__label subheading">{{ 'product.experience.highlight_moment' | t }}</p>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if route != blank or operations_note != blank or program_steps.size > 0 or faq_items.size > 0 -%}
          <div class="experience-details__accordions" data-animate>
            {%- if program_steps.size > 0 -%}
              {%- capture program_content -%}
                <ol class="experience-program">
                  {%- for step in program_steps -%}
                    <li class="experience-program__step">
                      <span class="experience-program__time subheading">{{ step.time.value }}</span>
                      <span class="experience-program__title">{{ step.step.value }}</span>
                      {%- if step.intention.value != blank -%}
                        <span class="experience-program__intention text-subdued">{{ step.intention.value }}</span>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ol>
              {%- endcapture -%}
              {%- render 'accordion', title: 'product.experience.program_title' | t, content: program_content, open: true -%}
            {%- endif -%}

            {%- if route != blank -%}
              {%- capture route_content -%}<div class="prose">{{ route }}</div>{%- endcapture -%}
              {%- render 'accordion', title: 'product.experience.route_title' | t, content: route_content -%}
            {%- endif -%}

            {%- if operations_note != blank -%}
              {%- capture operations_content -%}<div class="prose">{{ operations_note }}</div>{%- endcapture -%}
              {%- render 'accordion', title: 'product.experience.operations_note_title' | t, content: operations_content -%}
            {%- endif -%}

            {%- if faq_items.size > 0 -%}
              {%- capture faq_content -%}
                <div class="v-stack gap-4">
                  {%- for item in faq_items -%}
                    {%- capture answer_content -%}<div class="prose">{{ item.answer.value }}</div>{%- endcapture -%}
                    {%- render 'accordion', title: item.question.value, content: answer_content, subheading_title: true -%}
                  {%- endfor -%}
                </div>
              {%- endcapture -%}
              {%- render 'accordion', title: 'product.experience.faq_title' | t, content: faq_content, open: true -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if faq_items.size > 0 -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- for item in faq_items -%}
            {
              "@type": "Question",
              "name": {{ item.question.value | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ item.answer.value | strip_html | json }}
              }
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Experience details",
  "class": "shopify-section--product-experience-details",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Experience details"
    }
  ]
}
{% endschema %}