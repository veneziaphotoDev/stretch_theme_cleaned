{%- comment -%}
  ----------------------------------------------------------------------------------------------------------------------
  PRODUCT EXPERIENCE DETAILS SECTION
  ----------------------------------------------------------------------------------------------------------------------

  Renders the tour-specific content that lives below the fold: route, minute-by-minute program, operations note
  and FAQ. The above-the-fold content (tagline, quick facts, promise, what's included, privatization contact note,
  sunrise/sunset sibling link) lives in the buy-box itself via the "experience_summary", "experience_included",
  "experience_privatize" and "experience_sibling" blocks in snippets/product-info.liquid, so it sits next to the
  sticky gallery instead of below it. Meant to be placed on the product template, between "main" and
  "related-products".

  Expected metafields (namespace "custom"): guide_name, route_stops (list of metaobject "route_stop": name,
  optional image -- cropped to a fixed 4:5 ratio so mixed photo formats stay consistent), operations_note,
  itinerary (single metaobject reference to "itinerary": name, steps -- a list of metaobject "itinerary_step":
  time, step, intention), faq_set (single metaobject reference to "faq_set": name, items -- a list of metaobject
  "faq_item": question, answer), sibling_experience (single product reference, only set on products that share
  the same route as another product at the other time of day).

  The "itinerary" and "faq_set" metaobjects exist so a reusable, named group ("Sunrise -- Standard route",
  "Sunrise -- Standard FAQ") can be built once and attached to as many products as share it, instead of
  re-picking/reordering individual entries directly on every product.

  Every block below is skipped independently when its metafield is blank, so a product only needs to fill in
  whichever fields apply to it.
{%- endcomment -%}

{%- liquid
  assign route_stops = product.metafields.custom.route_stops.value
  assign operations_note = product.metafields.custom.operations_note.value
  assign program_steps = product.metafields.custom.itinerary.value.steps.value
  assign faq_items = product.metafields.custom.faq_set.value.items.value

  assign has_content = false
  if route_stops.size > 0 or operations_note != blank or program_steps.size > 0 or faq_items.size > 0
    assign has_content = true
  endif
-%}

{%- if has_content -%}
  <div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
    <div class="container section-spacing">
      <div class="experience-details">
        {%- if route_stops.size > 0 -%}
          <div class="experience-route" data-animate>
            <p class="experience-section-title subheading">{{ 'product.experience.route_title' | t }}</p>

            <scroll-carousel id="experience-route-{{ section.id }}" allow-swipe cell-selector=".experience-route__stop" class="experience-route__stops scroll-area bleed sm:unbleed snap-x" role="region">
              {%- for stop in route_stops -%}
                {%- assign stop_image = stop.image.value -%}
                <div class="experience-route__stop {% if stop_image != blank %}experience-route__stop--has-image{% endif %}" role="group" aria-label="{{ 'general.accessibility.item_nth_of_count' | t: index: forloop.index, count: route_stops.size }}">
                  {%- if stop_image != blank -%}
                    <div class="experience-route__stop-media">
                      {{- stop_image | image_url: width: 624, height: 832, crop: 'center' | image_tag: loading: 'lazy', sizes: '(max-width: 699px) 78vw, 26rem', widths: '312,624,832', alt: stop.name.value, class: 'experience-route__stop-image' -}}
                      <div class="experience-route__stop-caption">
                        <p class="experience-route__stop-index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</p>
                        <p class="experience-route__stop-name">{{ stop.name.value }}</p>
                      </div>
                    </div>
                  {%- else -%}
                    <p class="experience-route__stop-index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</p>
                    <p class="experience-route__stop-name">{{ stop.name.value }}</p>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </scroll-carousel>

            {%- if route_stops.size > 1 -%}
              <div class="experience-route__controls h-stack justify-between">
                <carousel-navigation class="scroll-marker-group scroll-marker-group--lines" aria-controls="experience-route-{{ section.id }}">
                  {%- for stop in route_stops -%}
                    <button class="scroll-marker tap-area tap-area--sm" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
                      <span class="sr-only">{{ 'general.accessibility.go_to_item' | t: index: forloop.index }}</span>
                    </button>
                  {%- endfor -%}
                </carousel-navigation>

                <div class="h-stack gap-2">
                  <carousel-prev-button aria-controls="experience-route-{{ section.id }}">
                    <button type="button" class="circle-button">
                      <span class="sr-only">{{ 'general.accessibility.previous' | t }}</span>
                      {%- render 'icon' with 'big-arrow-left', width: 9, direction_aware: true -%}
                    </button>
                  </carousel-prev-button>

                  <carousel-next-button aria-controls="experience-route-{{ section.id }}">
                    <button type="button" class="circle-button">
                      <span class="sr-only">{{ 'general.accessibility.next' | t }}</span>
                      {%- render 'icon' with 'big-arrow-right', width: 9, direction_aware: true -%}
                    </button>
                  </carousel-next-button>
                </div>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if program_steps.size > 0 -%}
          <div class="experience-program-block" data-animate>
            <p class="experience-section-title subheading">{{ 'product.experience.program_title' | t }}</p>
            <ol class="experience-program unstyled-list">
              {%- for step in program_steps -%}
                <li class="experience-program__step">
                  <span class="experience-program__time subheading">{{ step.time.value }}</span>
                  <div class="experience-program__body">
                    <p class="experience-program__title">{{ step.step.value }}</p>
                    {%- if step.intention.value != blank -%}
                      <p class="experience-program__intention text-subdued">{{ step.intention.value }}</p>
                    {%- endif -%}
                  </div>
                </li>
              {%- endfor -%}
            </ol>
          </div>
        {%- endif -%}

        {%- if operations_note != blank -%}
          <div class="experience-operations-note" data-animate>
            <p class="experience-section-title subheading">{{ 'product.experience.operations_note_title' | t }}</p>
            <div class="prose experience-operations-note__content">{{ operations_note }}</div>
          </div>
        {%- endif -%}

        {%- if faq_items.size > 0 -%}
          <div class="experience-faq" data-animate>
            <p class="experience-section-title subheading">{{ 'product.experience.faq_title' | t }}</p>
            <div class="experience-faq__list">
              {%- for item in faq_items -%}
                <div class="experience-faq__item">
                  <p class="experience-faq__question">{{ item.question.value }}</p>
                  <div class="prose experience-faq__answer">{{ item.answer.value }}</div>
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if faq_items.size > 0 -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- for item in faq_items -%}
            {
              "@type": "Question",
              "name": {{ item.question.value | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ item.answer.value | strip_html | json }}
              }
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Experience details",
  "class": "shopify-section--product-experience-details",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Experience details"
    }
  ]
}
{% endschema %}