mwH":{"type":"heading","settings":{"text":"A Place Apart","content_width":"sm","heading_tag":"h3","indent":"none","highlight_effect":"default","highlight_accent_color":"","highlight_text_color":""}},"richtext_UgDV3C":{"type":"richtext","settings":{"text":"<p>San Servolo has always existed slightly outside of time. Originally a Benedictine monastery, then a military hospital, then one of Venice's most storied psychiatric institutions, the island carries centuries of human stories within its walls. Today, it has been transformed into a vibrant cultural and academic campus, while preserving the quiet, contemplative atmosphere that has always defined it.<br\/><br\/>Walking through its gardens and colonnaded corridors, you quickly understand why it was chosen as the setting for a photography festival. There is something about San Servolo that invites looking — really looking — at the world.<\/p>","content_width":"lg","text_size":"default"}},"button_JxU7wt":{"type":"button","settings":{"text":"Read full article - 2 min read","url":"shopify:\/\/blogs\/article\/the-island","open_in_new_tab":false,"style":"link","background":"","text_color":"","icon":"","icon_position":"before_text"}}},"block_order":["heading_gN8mwH","richtext_UgDV3C","button_JxU7wt"],"name":"t:sections.rich_text.name","settings":{"anchor":"","fit_screen":false,"color_scheme":"","content_width":"lg","text_alignment":"center","layout":"default","reverse_columns":false,"group_with_next":false,"group_color_scheme":""}},"slideshow_9yBJnM":{"type":"slideshow","blocks":{"slideshow_image_slide_aYWb7A":{"type":"_slideshow-image-slide","name":"t:sections.slideshow.blocks.image.name","settings":{"color_scheme":"","image":"shopify:\/\/shop_images\/IMG_3146.jpg","slide_link":"","content_max_width":1000,"mobile_content_position":"place-self-center","desktop_content_position":"sm:place-self-center","overlay_color":"#000000","overlay_opacity":20,"show_branding":false},"blocks":{}},"slideshow_image_slide_Ary7AF":{"type":"_s