{%- render 'button', 
  content: block.settings.text, 
  href: block.settings.url,
  style: block.settings.style,
  background: block.settings.background,
  text_color: block.settings.text_color,
  external: block.settings.open_in_new_tab,
  icon: block.settings.icon,
  icon_position: block.settings.icon_position,
  block: block,
-%}

{% schema %}
{
  "name": "t:blocks.button.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:global.text.text",
      "default": "Button"
    },
    {
      "type": "url",
      "id": "url",
      "label": "t:global.text.link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:global.text.open_in_new_tab",
      "default": false
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:global.text.style",
      "options": [
        {
          "value": "outline",
          "label": "t:global.text.button_style_options.outline"
        },
        {
          "value": "solid",
          "label": "t:global.text.button_style_options.solid"
        },
        {
          "value": "link",
          "label": "t:global.text.button_style_options.link"
        }
      ],
      "default": "solid"
    },
    {
      "type": "color",
      "id": "background",
      "label": "t:global.colors.background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:global.text.text"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "t:global.icons.icon",
      "options": [
        {
          "value": "",
          "label": "t:global.icons.icon_options.none"
        },
        {
          "value": "custom-plus-icon",
          "label": "t:blocks.button.icon_options.plus"
        },
        {
          "value": "arrow-right",
          "label": "t:blocks.button.icon_options.arrow_right"
        },
        {
          "value": "arrow-left",
          "label": "t:blocks.button.icon_options.arrow_left"
        }
      ],
      "default": "custom-plus-icon"
    },
    {
      "type": "select",
      "id": "icon_position",
      "label": "t:blocks.button.icon_position",
      "options": [
        {
          "value": "before_text",
          "label": "t:blocks.button.icon_position_options.before_text"
        },
        {
          "value": "after_text",
          "label": "t:blocks.button.icon_position_options.after_text"
        }
      ],
      "default": "after_text"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.button.name"
    }
  ]
}
{% endschema %}